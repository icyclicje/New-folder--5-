# Copy to .env for local runs. On Railway, set these under Variables instead.

# Enables the AI Ranger: instant on-the-fly categories, Leader's Pick / Echo Trail
# generation, topic → full question bank, and judging of unlisted answers.
# Without it the game still works (word-association + Krillion-archive fallbacks).
ANTHROPIC_API_KEY=

# Optional tuning
# MIVI_AI_MODEL=claude-opus-5-5     # model used for generation
# MIVI_AI_FAST=1                    # Opus fast mode: up to ~2.5x faster output, premium pricing
# MIVI_AI_FALLBACKS=0               # disable server-side refusal fallbacks
# MIVI_AI_CONCURRENCY=16            # parallel generation streams
# MIVI_AI_WAVES=1                   # extra deep-search waves while a category is in play (0 = off, cheaper)
# MIVI_AI_SLICE_MODEL=              # optional faster model for the bulk letter-range streams
# MIVI_QLEVER_URL=                  # alternative Wikidata SPARQL engine for bulk lists
# MIVI_CONTACT=                     # your site URL or email, added to the Wikidata/Wikipedia User-Agent (their etiquette; fewer rate limits)

# Where profiles, ratings and the Krillion cache live. On Railway, mount a volume
# (e.g. at /data) and set DATA_DIR=/data so they survive redeploys.
# DATA_DIR=./data

# Krillion archive crawler
# KRILLION_SYNC=0                   # don't crawl (use whatever is cached)
# KRILLION_MAX_DAYS=0               # 0 = every daily since Dive #1
# PORT=3000
